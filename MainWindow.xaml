<Window x:Class="OpenShare.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenShare" Width="980" Height="680" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"><Grid Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="OPENSHARE" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"/><TextBlock Text="Send files directly. Keep control." FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Private, local-network transfers with integrity verification." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,9"><StackPanel><TextBlock Text="LOCAL ONLY" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/><TextBlock Text="No account · No cloud" Foreground="{StaticResource Text}" Margin="0,3,0,0"/></StackPanel></Border></Grid><Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="20" Margin="0,26,0,20"><StackPanel><TextBlock Text="RECEIVE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Give the sender your code" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/><StackPanel Orientation="Horizontal" Margin="0,13,0,0"><TextBlock x:Name="PairCode" Text="Not listening" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/><Button x:Name="ListenButton" Content="Start receiving" Click="Listen_Click" Margin="20,0,0,0"/><Button Content="Choose folder" Click="Folder_Click"/></StackPanel></StackPanel></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="20" Margin="0,0,10,0"><StackPanel><TextBlock Text="SEND" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Transfer to another device" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/><Button Content="Choose file" Click="File_Click" Margin="0,20,0,0" HorizontalAlignment="Left"/><TextBlock x:Name="FileText" Text="No file selected" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBox x:Name="CodeBox" Text="" ToolTip="Enter the receiver's code" Margin="0,17,0,0"/><Button Content="Send securely" Click="Send_Click" Margin="0,10,0,0" HorizontalAlignment="Left" Background="{StaticResource Accent}" Foreground="#0E201D"/></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="20" Margin="10,0,0,0"><StackPanel><TextBlock Text="ACTIVITY" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="Ready for a local transfer." FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/><ProgressBar x:Name="Progress" Height="8" Margin="0,22,0,0" Minimum="0" Maximum="1"/><TextBlock Text="Every completed transfer is verified with SHA-256." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border></Grid><TextBlock Grid.Row="3" Text="OpenShare 0.1.0 · MIT licensed · Not affiliated with Apple, Microsoft, Google, or any cloud provider" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/></Grid></Window>
